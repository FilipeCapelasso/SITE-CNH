{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "v",
          "value": "(?<slug>[a-z0-9-]+)"
        }
      ],
      "destination": "/:slug",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:slug",
      "destination": "/index.html"
    }
  ]
}
